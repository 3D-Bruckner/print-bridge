# print-bridge's settings. Copy to .env, fill in, chmod 600.

# Home Assistant, a long-lived access token (Profile → Security), and the A1's entity prefix in bambu_lab (sensor.<this>_druckstatus).
# Without the token the bridge waits.
PRINT_HA_URL=http://homeassistant.local:8123
PRINT_HA_TOKEN=
PRINT_HA_PRINTER=a1_0123456789abcde

# Invoice Ninja and an API token of a user allowed quotes and invoices only. Without the token the bridge waits.
PRINT_INVOICENINJA_URL=https://rechnungen.3dbruckner.de
PRINT_INVOICENINJA_TOKEN=

# The ntfy topic for the pushes ("Fertig: …", "Druck ohne Angebot", …). Without it, only the log says so.
PRINT_NTFY_URL=

# A quote's number as it appears in a print's name, a regular expression. Default: 3D-\d{4}-\d{4}
# PRINT_QUOTE_PATTERN=3D-\d{4}-\d{4}

# The log's level. Default: info
# PRINT_LOG_LEVEL=info

# Where print-bridge.sqlite lives. Default: /data
# DATA_DIR=/data

# The port /health answers on. Default: 8080
# PORT=8080

# Dates in the quote's notes and the log. Default in the image: Europe/Berlin
# TZ=Europe/Berlin

# The owner of /data inside the container. Default: the owner of the mounted folder
# PUID=1000
# PGID=1000

# Extra CA certificates (PEM), mounted.
# NODE_EXTRA_CA_CERTS=/certs/ca.pem
